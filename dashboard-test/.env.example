# dashboard-test 本机配置模板。复制成 .env 再填（.env 已 gitignore，不要提交）：
#   cp .env.example .env
# 已经在 shell 里设置的同名环境变量优先于本文件。

# 被测站点根地址（dashboard-v6 的 dev server）
E2E_BASE=http://127.0.0.1:4000/pcd-v2026/

# 测试账号（必填）。与 api-test 共用同一个账号时注意登录限流：同账号 + IP 每分钟 5 次
E2E_USER=test161
E2E_PASS=

# 讨论用例挂的句子：必须在测试账号自己的 channel 里、由测试账号编辑过
E2E_DISCUSSION_SENTENCE=ee5259be-5d1e-4408-a2a6-566a5773eef1

# 截图输出目录；不设则各 spec 写到 testlog/assets/<路由>_latest
# E2E_SHOT=testlog/assets/channel_20260101_000000

# 设为 0 跳过增删改用例
# E2E_DESTRUCTIVE=0
